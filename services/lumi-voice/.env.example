# Standalone example; do not place real credentials in this file.
# setup-qwen.py generates a private .env.qwen.local with a random token.
# The server reads process variables, not this file automatically.
TTS_PROVIDER=qwen
QWEN_TTS_URL=http://127.0.0.1:8766
QWEN_TTS_API_TOKEN=
QWEN_TTS_HOST=127.0.0.1
QWEN_TTS_PORT=8766
# For containers set HOST=0.0.0.0 and list exact DNS names with ports.
# Example: QWEN_TTS_ALLOWED_HOSTS=projeto_voice:8766
QWEN_TTS_ALLOWED_HOSTS=
QWEN_TTS_DEVICE=auto

# Relative to the service directory when starting server.py there.
# Use Base only after installing it and provisioning voices/lumi privately.
QWEN_TTS_MODEL_DIR=models/base
QWEN_TTS_REFERENCE_DIR=voices/lumi
QWEN_TTS_CACHE_DIR=cache/prepared

# Docker defaults use /data/models/base, /data/voices/lumi and /data/cache/prepared.
# The same private QWEN_TTS_API_TOKEN must be configured in the platform API.

# PostgreSQL: use a private server-only URL. Never use NEXT_PUBLIC_ or VITE_ prefixes.
DATABASE_DRIVER=postgres
DATABASE_SCHEMA=letria
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# Optional Lumi AI. Empty key keeps local educational hints active.
# Copy to .env and configure privately; never put keys in NEXT_PUBLIC_*.
# Remote Lumi is disabled by default. Select deepseek, openai or local.
TUTOR_PROVIDER=local
# Activate only after approving this destination and payload:
# https://api.deepseek.com/chat/completions receives the question, up to six
# conversation messages, and validated exercise text/options (no profile or answer key).
# Typed messages may themselves contain personal information. Keep keys private.
# Both explicit ENABLED=true and a key are required for DeepSeek requests.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Natural narration (gpt-4o-mini-tts); uses the same private API key.
OPENAI_TTS_VOICE=marin

# Optional local Dora provider (npm run voice:setup creates a private configuration).
# Set TTS_PROVIDER=kokoro to select Dora. No OpenAI calls are made for narration.
# TTS_PROVIDER=kokoro
# KOKORO_URL=http://127.0.0.1:8765
# KOKORO_API_TOKEN=use-the-generated-private-token

# Optional local Qwen voice for Lumi. Selecting qwen never falls back to a paid API.
# TTS_PROVIDER=qwen
QWEN_TTS_URL=http://127.0.0.1:8766
QWEN_TTS_API_TOKEN=

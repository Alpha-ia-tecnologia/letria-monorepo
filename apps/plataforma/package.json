{
  "name": "letria-plataforma",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/start-server.mjs",
    "test": "npm run test:unit && npm run test:api && npm run test:migration",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:api": "node --test tests/api-security.test.mjs",
    "test:http": "node --test tests/api-http-smoke.test.mjs",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/postgres-migrate.mjs",
    "voice:setup": "python ../../services/kokoro/scripts/setup-kokoro.py",
    "voice:test": "python -m unittest discover -s ../../services/kokoro -p test_*.py",
    "start:kokoro": "node scripts/start-kokoro.mjs",
    "db:apply": "node scripts/postgres-migrate.mjs --apply",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:migration": "node --test tests/postgres-migration.test.mjs",
    "voice:qwen:setup": "python ../../services/lumi-voice/scripts/setup-qwen.py",
    "voice:qwen:test": "python -m unittest discover -s ../../services/lumi-voice -p test_*.py",
    "start:qwen": "node scripts/start-qwen.mjs",
    "voice:qwen:base:setup": "python ../../services/lumi-voice/scripts/setup-qwen-base.py",
    "voice:prepare": "tsx scripts/prepare-speech.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

# Paste into the platform service's Environment editor in Easypanel.
# OpenAI narration uses the existing integration; Claude Sonnet 5.5 is the tutor and DeepSeek its fallback.
# Replace placeholders privately. Never commit real credentials.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# One private Easypanel proxy; do not publish the container port directly.
LETRIA_TRUST_PROXY_HOPS=1
VINEXT_TRUSTED_HOSTS=aprender.seudominio.com.br
AUDIO_STORAGE_DIR=/data/recordings

DATABASE_DRIVER=postgres
DATABASE_SCHEMA=letria
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require

TUTOR_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Fallback: answers only when Claude is unavailable, never after a safety decline.
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# External voice API; no separate Qwen/Voice service is required.
TTS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TTS_VOICE=marin

# Environment editor for the separate letria-voice service.
QWEN_TTS_HOST=0.0.0.0
QWEN_TTS_PORT=8766
QWEN_TTS_ALLOWED_HOSTS=projeto_voice:8766
QWEN_TTS_API_TOKEN=
QWEN_TTS_DEVICE=cpu
QWEN_TTS_MODEL_DIR=/data/models/base
QWEN_TTS_REFERENCE_DIR=/data/voices/lumi
QWEN_TTS_CACHE_DIR=/data/cache/prepared
# Mount a persistent volume at /data; provision models/reference before startup.
# For GPU: configure host/container GPU access, compatible PyTorch CUDA build,
# then set QWEN_TTS_DEVICE=cuda. Changing this variable alone is insufficient.

# Paste into the platform service's Environment editor in Easypanel.
# Replace placeholders privately. The Git image contains no production credentials.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# One private Easypanel proxy; do not publish the container port directly.
LETRIA_TRUST_PROXY_HOPS=1
VINEXT_TRUSTED_HOSTS=aprender.seudominio.com.br
AUDIO_STORAGE_DIR=/data/recordings

DATABASE_DRIVER=postgres
DATABASE_SCHEMA=letria
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require

TUTOR_PROVIDER=deepseek
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

TTS_PROVIDER=qwen
# Replace 'projeto' and 'voice' with your real Easypanel project/service names.
QWEN_TTS_URL=http://projeto_voice:8766
QWEN_TTS_ALLOW_HTTP_ORIGIN=http://projeto_voice:8766
# Same random token (at least 32 characters, no spaces) as the voice service.
QWEN_TTS_API_TOKEN=
